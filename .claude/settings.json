{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "command": "bash .claude/hooks/pre-commit-guard.sh",
        "description": "git commit 前自动运行测试 + lint 门禁"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "command": "bash .claude/hooks/on-after-commit.sh",
        "description": "git commit 后通知 Reviewer + Documenter"
      }
    ],
    "SessionStart": [
      {
        "command": "bash .claude/hooks/on-session-start.sh",
        "description": "启动时扫描待处理信号，提示当前角色任务"
      }
    ],
    "Stop": [
      {
        "command": "bash .claude/hooks/on-session-stop.sh",
        "description": "Session 结束时记录工作检查点"
      }
    ]
  }
}
